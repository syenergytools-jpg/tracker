{
  "name": "evolut-productivity-agent",
  "version": "1.0.0",
  "private": true,
  "description": "Windows desktop agent extending Evolut Productivity Tracker to non-browser applications.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "active-win": "^8.2.1",
    "dotenv": "^18.0.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.evolut.productivity-agent",
    "productName": "Evolut Productivity Agent",
    "win": {
      "target": "nsis",
      "icon": "icons/icon.ico"
    },
    "files": ["main.js", "preload.js", "popup.html", "popup.css", "popup.js", "src/**/*", "icons/**/*", ".env"]
  }
}
